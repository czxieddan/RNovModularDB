# AHCL Kit project configuration.
schema = 1
materials-directory = ".ahcl"
languages:
  - "rust"

[project]
name = "RNovModularDB"
canonical-repository = "https://github.com/czxieddan/RNovModularDB"
canonical-branch = "master"
right-holders:
  - "czxieddan"
